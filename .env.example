# Public client configuration template. Copy to .env and fill in locally; .env is git-ignored.
# Only browser-safe values belong in VITE_* variables. Never put a service-role, secret, or
# server API key here: anything prefixed VITE_ is embedded in the public bundle.

VITE_SUPABASE_URL=
# Browser-safe publishable key (preferred).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key, used only when no publishable key is set.
VITE_SUPABASE_ANON_KEY=

# Private Palau pilot routes (/pilot/private/:tripId, /pilot/invite) stay fail-closed unless
# this is exactly "true". Leave false until the isolated migration and staging checks are approved.
VITE_PALAU_PRIVATE_ENABLED=false
# Pilot uses a separate backend configuration and session namespace; no legacy fallback.
VITE_PALAU_SUPABASE_URL=
VITE_PALAU_SUPABASE_PUBLISHABLE_KEY=

# Optional map rendering (falls back to an embed without it).
VITE_MAPBOX_TOKEN=

# Model providers, print and postcard providers are configured server-side only
# (see api/ and the deployment environment). Do not add their keys as VITE_ variables.

# General dashboard/create-trip foundation; leave false until its migration is approved and applied.
VITE_VYBR_TRIP_FOUNDATION_ENABLED=false

# Shared journey/photo presentation is a separate, unreleased integration.
VITE_VYBR_JOURNEY_ENABLED=false

# Local coordinate plot only; no provider or GPS. Pending release review.
VITE_VYBR_STOP_MAP_ENABLED=false
